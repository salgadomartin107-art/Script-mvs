#!/usr/bin/env bash
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/ui.sh"
source "$ROOT/lib/notify.sh"
source "$ROOT/lib/users.sh"
# shellcheck disable=SC1090
for m in "$ROOT"/modules/*.sh; do source "$m"; done

# Si se corta la conexión (el celular se duerme, se cae la red), el terminal desaparece y read falla al instante;
# los menús son bucles "while true", así que girarían al 100 % de CPU para siempre. Con esto el panel termina solo.
trap 'exit 0' HUP TERM
read() {
    local __rd_arg __rd_ask=0 __rd_rc
    for __rd_arg in "$@"; do [[ "$__rd_arg" == -[a-zA-Z]*p* ]] && __rd_ask=1; done
    if (( __rd_ask )); then
        [[ -t 0 ]] || exit 0
        builtin read "$@"; __rd_rc=$?
        (( __rd_rc != 0 && __rd_rc <= 128 )) && exit 0      # EOF / terminal cerrado (Ctrl-D también sale)
        return "$__rd_rc"
    fi
    builtin read "$@"
}

require_root
ensure_data
[[ "$ROOT" == "/opt/${APP_SLUG}" ]] \
    || warn "Estás ejecutando desde $ROOT. Los servicios usan /opt/${APP_SLUG}: instalá con ./install.sh y abrí el panel con el comando 'menu'."

menu_users() {
    local op name pass days limit
    while true; do
        title "Usuarios SSH"
        users_summary; bar
        echo " 1) Crear usuario      4) Cambiar límite"
        echo " 2) Eliminar usuario   5) Listar usuarios"
        echo " 3) Renovar usuario    6) Quién está conectado"
        echo " 0) Volver"
        bar; read -rp " Opción: " op
        case "$op" in
            1) user_create_prompt; pause ;;
            2) read -rp "Usuario a eliminar: " name; user_delete "$name"; pause ;;
            3) read -rp "Usuario: " name; read -rp "Días [30]: " days; user_renew "$name" "${days:-30}"; pause ;;
            4) read -rp "Usuario: " name; read -rp "Nuevo límite: " limit; user_set_limit "$name" "$limit"; pause ;;
            5) user_list; pause ;;
            6) user_list 1; pause ;;
            0) return ;;
        esac
    done
}

if [[ "${1:-}" == "--uninstall" ]]; then uninstall_all; exit 0; fi
if [[ "${1:-}" == "--update" ]]; then update_script; exit $?; fi

# Un solo menú: la pantalla de dos columnas (usuarios y Telegram están ahí como [U] y [K]).
panel_menu
clear
